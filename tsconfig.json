{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"lib": [
			"es2015",
			"dom"
		],
		"module": "commonjs",
		"outDir": "./dist/cjs/",
		"removeComments": true,
		"rootDir": "./src/",
		"skipLibCheck": true,
		"strict": true,
		"sourceMap": true,
		"target": "es2015"
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src/**/*.ts"
	]
}
